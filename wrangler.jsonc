{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-dra-milena-miranda",
  "main": "worker.js",
  "compatibility_date": "2026-11-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}

